---
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Eyebrow from '../components/site/Eyebrow.astro';
import Card from '../components/core/Card.astro';
import Icon from '../components/core/Icon.astro';
import Button from '../components/core/Button.astro';
import AffirmationLine from '../components/core/AffirmationLine.astro';
import { INBOX, PHONE, CALENDAR_URL, HUBSPOT_PORTAL_ID, HUBSPOT_FORM_ID, HUBSPOT_REGION } from '../config';

/* Paid traffic lands here, so the address and number stay real links: the ads
   side tracks clicks on both as secondary actions. tel: needs the number
   stripped back to digits and a leading +. */
const CONTACT_ROWS: [string, string, string | null][] = [
  ['mail', INBOX, `mailto:${INBOX}`],
  ['phone', PHONE, `tel:${PHONE.replace(/[^\d+]/g, '')}`],
  ['shield-check', 'HIPAA-compliant intake, BAA on request', null],
];
---

<Base
  title="Averis, Contact"
  description="Send us the allegation letter. We will read it and the sampling method, and come back with what we would need to test it."
  page="contact"
>
  <Section tone="bone" class="contact">
    <div class="contact__grid">
      <div>
        <Eyebrow>Contact</Eyebrow>
        <h1 class="contact__heading">Send us the allegation letter.</h1>
        <p class="contact__body">
          We will read the letter and the sampling method, and come back with what we would need to test it. No cost for
          the first read.
        </p>
        <AffirmationLine width={90} class="contact__rule" />
        {
          CONTACT_ROWS.map(([ic, t, href]) => (
            <div class="contact__row">
              <Icon name={ic} size={16} color="var(--text-faint)" />
              {href ? <a href={href}>{t}</a> : t}
            </div>
          ))
        }

        <div class="contact__book">
          <p class="contact__book-note">Prefer to talk it through first?</p>
          <Button variant="secondary" href={CALENDAR_URL} target="_blank">
            Book a call
            <Icon slot="icon-right" name="arrow-right" size={15} />
          </Button>
        </div>
      </div>

      <Card padding={30}>
        {/* Runs during parse, so it lands before the deferred HubSpot embed
            below. HubSpot pre-fills a hidden field from a matching query
            parameter, so putting the stored click ID back on the URL is how the
            value reaches the submission. A gclid is an ad identifier, not
            personal or health data, so it is safe in the address bar. */}
        <script is:inline>
          (function () {
            try {
              var s = JSON.parse(localStorage.getItem('gclid') || 'null');
              /* Google accepts offline conversion imports for 90 days after the click. */
              if (!s || Date.now() - s.t >= 90 * 864e5) return;
              var url = new URL(location.href);
              if (url.searchParams.get('gclid')) return;
              url.searchParams.set('gclid', s.v);
              history.replaceState(null, '', url);
            } catch (e) {}
          })();
        </script>
        <script src={`https://js-na2.hsforms.net/forms/embed/${HUBSPOT_PORTAL_ID}.js`} defer is:inline></script>
        <div
          class="hs-form-frame"
          data-region={HUBSPOT_REGION}
          data-form-id={HUBSPOT_FORM_ID}
          data-portal-id={HUBSPOT_PORTAL_ID}
        >
        </div>
        <p class="form__footnote">
          Do not send protected health information through this form. We will provide a secure channel at intake.
        </p>
        <p class="form__fallback">
          If the form does not load, email us at <a href={`mailto:${INBOX}`}>{INBOX}</a>.
        </p>
      </Card>
    </div>
  </Section>
</Base>

{/* The conversion event is not fired here. HubSpot redirects to
    /request-received on success and the event fires there, so a submission is
    counted once, on a page only a real submission can reach. Firing on
    HubSpot's onFormSubmitted callback as well would double every conversion. */}

<style>
  /* .contact rides on <Section>, which carries its own scope and not this
     page's, so the override has to be global. Same for the rule below. */
  :global(.contact) {
    padding: 64px 0 80px;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 56px;
    align-items: start;
  }

  .contact__heading {
    font-size: var(--text-h1);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
  }

  .contact__body {
    margin-top: 14px;
    font-size: var(--text-body-lg);
    color: var(--text-body);
  }

  :global(.contact .contact__rule) {
    margin: 26px 0;
  }

  .contact__row {
    display: flex;
    gap: 11px;
    align-items: center;
    padding: 7px 0;
    font-size: var(--text-body-md);
    color: var(--text-strong);
  }

  .contact__book {
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--border-hairline);
  }

  .contact__book-note {
    font-size: var(--text-body-md);
    color: var(--text-body);
    margin-bottom: 12px;
  }

  /* Reserves height so the card does not jump when the embed renders. */
  .hs-form-frame {
    min-height: 420px;
  }

  .form__footnote,
  .form__fallback {
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin-top: 14px;
  }

  @media (max-width: 1000px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
</style>
