---
interface Props {
  tone?: 'sand' | 'outline' | 'green';
  /** Renders the remove affordance. Wire the handler at the call site. */
  removable?: boolean;
  class?: string;
}

const { tone = 'sand', removable = false, class: className } = Astro.props;
---

<span class:list={['tag', `tag--${tone}`, className]}>
  <slot />
  {
    removable && (
      <button type="button" class="tag__remove" aria-label="Remove">
        &#215;
      </button>
    )
  }
</span>

<style>
  .tag {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    font-weight: 500;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .tag--sand {
    background: var(--surface-neutral);
    color: var(--averis-slate-mid);
  }
  .tag--outline {
    background: transparent;
    color: var(--text-heading);
    box-shadow: inset 0 0 0 1px var(--border-soft);
  }
  .tag--green {
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
  }

  .tag__remove {
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
    opacity: 0.6;
    font-size: 13px;
    line-height: 1;
    padding: 0;
  }
</style>
