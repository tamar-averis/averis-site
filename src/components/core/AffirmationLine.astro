---
/* The brand's signature device: a champagne rule that underlines a claim.
   Always horizontal, always champagne, always fully rounded caps. */
interface Props {
  tone?: 'light' | 'dark';
  thickness?: number;
  /** How far the line runs past its container, in px. */
  overhang?: number;
  width?: string | number;
  class?: string;
  style?: string;
}

const { tone = 'light', thickness = 4, overhang = 8, width, class: className, style } = Astro.props;

const resolvedWidth = width === undefined ? `calc(100% + ${overhang}px)` : typeof width === 'number' ? `${width}px` : width;
---

<span
  class:list={['affirm', tone === 'dark' && 'affirm--dark', className]}
  style={`--affirm-thickness:${thickness}px;--affirm-width:${resolvedWidth};${style ?? ''}`}
  aria-hidden="true"
/>

<style>
  .affirm {
    display: block;
    height: var(--affirm-thickness);
    width: var(--affirm-width);
    border-radius: var(--radius-xs);
    background: var(--accent-line-on-light);
  }

  .affirm--dark {
    background: var(--accent-line);
  }
</style>
