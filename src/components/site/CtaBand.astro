---
import Button from '../core/Button.astro';

interface Props {
  headingMax?: number;
}

const { headingMax = 560 } = Astro.props;
---

<div class="cta-band">
  <div class="wrap cta-band__inner">
    <h2 class="cta-band__heading" style={`max-width:${headingMax}px`}><slot /></h2>
    <Button variant="accent" size="lg" href="/contact">Request an analysis</Button>
  </div>
</div>

<style>
  .cta-band {
    background: var(--surface-inverse-deep);
    padding: 72px 0;
  }

  .cta-band__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .cta-band__heading {
    font-size: var(--text-h1);
    font-weight: 700;
    color: var(--text-on-inverse);
  }

  @media (max-width: 820px) {
    .cta-band {
      padding: 48px 0;
    }

    .cta-band__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
    }
  }
</style>
